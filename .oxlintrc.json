{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "vue",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "release/**"
  ],
  "overrides": [
    {
      "files": [
        "tests/**",
        "scripts/**"
      ],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ],
  "rules": {
    "no-control-regex": "off"
  }
}
