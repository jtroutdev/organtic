{
  "name": "organtic",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop media matcher and safe file renamer",
  "author": "Organtic contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtroutdev/organtic.git"
  },
  "homepage": "https://github.com/jtroutdev/organtic",
  "type": "module",
  "main": "build/desktop/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "npm run build && electron .",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/readex-pro": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "axe-core": "^4.14.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "8.3.3"
  },
  "build": {
    "appId": "org.organtic.desktop",
    "productName": "Organtic",
    "files": [
      "dist/**/*",
      "build/**/*",
      "desktop/preload.cjs",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
